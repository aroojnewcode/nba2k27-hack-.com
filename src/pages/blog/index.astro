---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/blog-pages.css';
import { blogPosts, getBlogFilterTags } from '../../data/blog';
import { t } from '../../i18n';
import { resolvePageSeo } from '../../config/seo';
import { breadcrumbSchema, collectionPageSchema } from '../../utils/schema';
import { CARD_IMAGE_WIDTHS, webpSrc } from '../../utils/responsiveImage';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BlogCard from '../../components/BlogCard.astro';
import BlogSortSelect from '../../components/BlogSortSelect.astro';
import Icon from '../../components/icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { ROUTES } from '../../utils/path';

const seo = resolvePageSeo('/blog/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
];

const gridPosts = blogPosts;
const filterTags = getBlogFilterTags();
const lcpImage = webpSrc(blogPosts[0]!.image, CARD_IMAGE_WIDTHS[0]);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    collectionPageSchema({
      name: t.blog.title,
      description: t.blog.subtitle,
      url: '/blog/',
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <link slot="head" rel="preload" as="image" href={lcpImage} type="image/webp" fetchpriority="high" />

  <section class="border-y border-border bg-muted/20 py-12 md:py-16" aria-labelledby="blog-latest-title">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <header class="section-header mt-6 max-w-2xl md:mt-8">
        <p class="section-header__eyebrow">{t.blog.eyebrow}</p>
        <h1 id="blog-latest-title" class="section-header__title">{t.blog.latestTitle}</h1>
        <p class="section-header__subtitle">{t.blog.latestSubtitle}</p>
      </header>

      <div class="blog-toolbar mt-8 lg:mt-10" role="search">
        <div class="blog-toolbar__controls">
          <div class="blog-toolbar__search">
            <label class="blog-toolbar__label" for="blog-search">{t.blog.searchLabel}</label>
            <input
              id="blog-search"
              type="search"
              class="blog-toolbar__search-input"
              placeholder={t.blog.searchPlaceholder}
              autocomplete="off"
              spellcheck="false"
              data-blog-search
            />
          </div>
          <BlogSortSelect layout="toolbar" />
        </div>

        <div class="blog-toolbar__filters" role="toolbar" aria-label="Filter articles by topic">
          <button
            type="button"
            class="blog-filter"
            data-blog-filter="all"
            aria-pressed="true"
          >
            {t.blog.filterAll}
          </button>
          {
            filterTags.map((tag) => (
              <button
                type="button"
                class="blog-filter"
                data-blog-filter={tag}
                aria-pressed="false"
              >
                {tag}
              </button>
            ))
          }
        </div>
      </div>

      <div id="blog-grid" class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-8 lg:gap-y-10">
        {gridPosts.map((post, index) => (
          <BlogCard post={post} index={index} showDate />
        ))}
      </div>

      <p
        id="blog-empty"
        class="mt-10 hidden text-center text-muted-foreground"
        role="status"
        data-empty-message={t.blog.emptyFilter}
      >
        {t.blog.emptyFilter}
      </p>

      <div class="mt-12 flex justify-start lg:justify-center">
        <Button as="a" href={ROUTES.home} variant="outline">
          <Icon name="chevronLeft" size={16} />
          Back to home
        </Button>
      </div>
    </div>
  </section>

  <script type="module">
    import { initBlogIndexFilters } from '../../scripts/blog-index.ts';

    const run = () => initBlogIndexFilters();
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run, { once: true });
    } else {
      run();
    }
  </script>
</BaseLayout>
