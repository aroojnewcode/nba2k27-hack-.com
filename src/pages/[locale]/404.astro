---
export { localeStaticPaths as getStaticPaths } from '../../utils/localeStaticPaths';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n';

import { pageLocale } from '../../utils/locale';

const locale = pageLocale(Astro);
const t = getTranslations(locale);
import Icon from '../../components/icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { localizedRoute, ROUTES } from '../../utils/path';


---


<BaseLayout
  title={`${t.notFound.title} | ${t.site.name}`}
  description={t.notFound.description}
  noindex={true}
>
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-lg px-5 text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary">404</p>
      <h1 class="mt-3 text-3xl font-bold uppercase md:text-4xl">{t.notFound.heading}</h1>
      <p class="mt-4 text-muted-foreground">{t.notFound.body}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
        <Button as="a" href={localizedRoute(locale, ROUTES.home)} variant="primary">
          {t.notFound.backHome}
          <Icon name="arrowRight" size={17} />
        </Button>
        <Button as="a" href={localizedRoute(locale, ROUTES.products)} variant="outline">{t.notFound.viewProducts}</Button>
        <Button as="a" href={localizedRoute(locale, ROUTES.productsElite)} variant="outline">{t.notFound.viewElite}</Button>
      </div>
    </div>
  </section>
</BaseLayout>
