---
import '../../../../styles/product-cheat-page.css';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getProductHub, getProductPages } from '../../../../data/products';
import { getTranslations } from '../../../../i18n';
import { pageLocale } from '../../../../utils/locale';

const locale = pageLocale(Astro);
const t = getTranslations(locale);
const productHub = getProductHub(locale);
const productPages = getProductPages(locale);
import { resolvePageSeo } from '../../../../config/seo';
import { breadcrumbSchema, itemListSchema, webPageSchema } from '../../../../utils/schema';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import { localizedInternalPath } from '../../../../utils/locale';
import { productPath, productsUtilitiesPath } from '../../../../utils/path';

export { localeStaticPaths as getStaticPaths } from '../../../../utils/localeStaticPaths';
import { Button } from '@/components/starwind/button';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/starwind/card';
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from '@/components/starwind/table';

const utilities = productPages.filter((p) => p.kind === 'utility');
const seo = resolvePageSeo('/products/nba-2k27-hack/utilities/', locale);
const utilitiesPath = productsUtilitiesPath(locale);
const breadcrumbs = [
  { name: 'Home', path: localizedInternalPath(locale, '/') },
  { name: 'Products', path: productHub.path },
  { name: t.productsUtilities.breadcrumb, path: utilitiesPath },
];

const utilityUseCases: Record<string, string> = {
  'hwid-spoofer': 'New PC or hardware flag after a ban—reset how your machine appears before a new account.',
  'unlock-all': 'Local preview for courts, jerseys, and MyPlayer gear without buying every cosmetic.',
};
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({
      name: 'Compare NBA 2K27 utilities',
      description: seo.description,
      url: utilitiesPath,
    }),
    breadcrumbSchema(breadcrumbs),
    itemListSchema(
      utilities.map((product) => ({
        name: product.title,
        url: productPath(product.slug, locale),
      })),
    ),
  ]}
>
  <section class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />

      <header class="mt-6 max-w-3xl space-y-3">
        <h1 class="text-3xl font-bold uppercase md:text-4xl">{t.productsUtilities.title}</h1>
        <p class="text-lg text-muted-foreground">{t.productsUtilities.subtitle}</p>
      </header>

      <div class="mt-10 rounded-lg border border-border" tabindex="0" aria-label="Utility comparison">
        <Table>
          <TableHeader>
            <TableRow>
              <TableHead>Utility</TableHead>
              <TableHead>Best for</TableHead>
              <TableHead>Product page</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {utilities.map((product) => (
              <TableRow>
                <TableCell class="font-medium">{product.title}</TableCell>
                <TableCell class="text-muted-foreground">{utilityUseCases[product.slug] ?? product.desc}</TableCell>
                <TableCell>
                  <a href={productPath(product.slug, locale)} class="text-primary hover:underline">
                    View {product.category ?? 'details'}
                  </a>
                </TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>
      </div>

      <ul class="mt-10 space-y-4">
        {utilities.map((product) => (
          <li>
            <Card>
              <CardHeader>
                <CardTitle class="text-lg normal-case">
                  <a href={productPath(product.slug, locale)} class="hover:text-primary">{product.title}</a>
                </CardTitle>
              </CardHeader>
              <CardContent class="space-y-2 text-sm text-muted-foreground">
                <p>{product.desc}</p>
                <p>
                  <strong class="text-foreground">Includes:</strong>{' '}
                  {product.features.slice(0, 4).join(' · ')}
                  {product.more > 0 ? ` · +${product.more} more` : ''}
                </p>
              </CardContent>
            </Card>
          </li>
        ))}
      </ul>

      <div class="mt-10">
        <Button as="a" href={productHub.path} variant="outline">Back to products</Button>
      </div>
    </div>
  </section>
</BaseLayout>
