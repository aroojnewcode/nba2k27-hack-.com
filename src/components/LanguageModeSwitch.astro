---
import { t } from '../i18n';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['lang-mode-switch', className]} data-lang-switch>
  <span class="lang-mode-switch__label sr-only">{t.ui.languageLabel}</span>
  <button
    type="button"
    class="lang-mode-switch__btn is-active"
    aria-pressed="true"
    disabled
    title={t.ui.languageEn}
  >
    {t.ui.languageCode}
  </button>
</div>

<style>
  .lang-mode-switch {
    display: inline-flex;
    align-items: center;
  }

  .lang-mode-switch__btn {
    min-width: 2.5rem;
    height: 2rem;
    padding: 0 0.65rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in oklch, var(--border) 80%, var(--primary) 20%);
    background: color-mix(in oklch, var(--muted) 40%, transparent);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--foreground);
    cursor: default;
  }

  .lang-mode-switch__btn.is-active {
    border-color: color-mix(in oklch, var(--primary) 45%, var(--border));
    background: color-mix(in oklch, var(--primary) 14%, var(--background));
    color: var(--foreground);
  }

  html.dark .lang-mode-switch__btn.is-active {
    background: color-mix(in oklch, var(--primary) 22%, var(--background));
  }
</style>
