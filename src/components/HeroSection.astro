---
import '../styles/hero-section.css';
import { discordInviteUrl } from '../config/discord';
import { getTranslations } from '../i18n';
import { localizedRoute, ROUTES } from '../utils/path';
import { pageLocale } from '../utils/locale';

const locale = pageLocale(Astro);
const productsHref = localizedRoute(locale, ROUTES.products);
import { homeHeroBackground, homeHeroSlides } from '../data/heroImages';
import { compatibilityIcons, heroStatIcons, heroStatusPills } from '../data/sectionIcons';
import { webpSrc, HERO_IMAGE_WIDTHS } from '../utils/responsiveImage';
import ImageSlider from './ImageSlider.astro';
import Icon from './icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { Badge } from '@/components/starwind/badge';

const t = getTranslations(locale);
const h = t.hero;
const discordHref = discordInviteUrl();
const heroBg = webpSrc(homeHeroBackground, HERO_IMAGE_WIDTHS[1] ?? 640);

const heroMarqueePills = [
  ...heroStatusPills,
  ...t.compatibility.items.map((label, i) => ({
    label,
    icon: compatibilityIcons[i] ?? 'check',
  })),
];
---

<section
  id="hero"
  class="hero-section hero-section--immersive"
  aria-labelledby="hero-title"
>
  <div class="hero-section__bg" aria-hidden="true">
    <img src={heroBg} alt="" width="960" height="540" loading="eager" decoding="async" fetchpriority="high" />
    <div class="hero-section__bg-overlay"></div>
  </div>

  <div class="hero-section__inner relative mx-auto flex max-w-6xl flex-col justify-center px-5">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
      <div class="w-full max-w-xl space-y-5 text-left md:space-y-6 lg:max-w-2xl">
        <p class="hero-section__kicker">{h.status}</p>

        <h1 id="hero-title" class="hero-section__title">
          <span class="hero-section__title-accent">{h.titleLine1}</span>
          <span class="block">{h.titleLine2}</span>
          <span class="block">{h.titleLine3}</span>
        </h1>

        <p class="hero-section__subtitle">{h.subtitle}</p>

        <div class="flex flex-wrap justify-start gap-3 sm:gap-4">
          <Button
            as="a"
            href={productsHref}
            data-scroll-target="products"
            variant="outline"
            size="lg"
            class="hero-section__cta-outline rounded-xl"
          >
            {h.ctaPrimary}
            <Icon name="arrowRight" size={18} />
          </Button>
          <Button
            as="a"
            href={discordHref}
            variant="secondary"
            size="lg"
            class="hero-section__cta-discord relative z-[2] rounded-xl"
            aria-label={t.ui.discordAria}
            data-external-cta
          >
            <Icon name="messageCircle" size={18} />
            {h.ctaDiscord}
          </Button>
        </div>
      </div>

      <div class="mx-auto flex w-full max-w-xl flex-col items-center gap-5 lg:mx-0 lg:max-w-none lg:items-end">
        <div class="hero-section__media w-full">
          <ImageSlider images={homeHeroSlides} id="hero-slider" variant="hero" />
        </div>
        <div class="grid w-full grid-cols-2 gap-2.5 sm:gap-3 md:grid-cols-4 lg:grid-cols-2">
          {h.metrics.map((m, i) => (
            <div
              class="hero-section__metric flex min-w-0 items-center gap-3 rounded-xl border border-border/80 px-3 py-3 shadow-sm transition-colors hover:border-primary/40"
            >
              <span
                class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary/20 ring-1 ring-inset ring-primary/35"
                aria-hidden="true"
              >
                <Icon name={heroStatIcons[i] ?? 'check'} size={18} />
              </span>
              <div class="min-w-0">
                <p class="font-[family-name:var(--font-heading)] text-base font-bold leading-none tracking-tight">{m.strong}</p>
                <p class="mt-1 text-xs leading-tight text-muted-foreground">{m.label}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="hero-status-marquee relative mt-10 md:mt-12 lg:mt-14" aria-label="Features and platform support">
      <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-12 bg-gradient-to-r from-background to-transparent" aria-hidden="true" />
      <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-12 bg-gradient-to-l from-background to-transparent" aria-hidden="true" />
      <div class="hero-status-marquee-track flex w-max gap-2">
        {[...heroMarqueePills, ...heroMarqueePills].map((pill, i) => (
          <Badge variant="outline" class="hero-marquee-badge group/badge shrink-0 gap-1 py-0.5 pl-1.5 pr-2.5 text-xs whitespace-nowrap">
            <Icon name={pill.icon} size={13} />
            {pill.label}
          </Badge>
        ))}
      </div>
    </div>
  </div>
</section>
